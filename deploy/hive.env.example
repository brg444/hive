# /etc/hive/hive.env, read by the service, the delegatee, the backup and the check. Readable by root and the hive group.
# Quote any value with spaces or an ampersand: setup.sh reads this file with the shell too.

# The service's address and the keeper console's, each with its own certificate.
HIVE_HOST=hive.example.org
KEEPER_HOST=keeper.example.org
HIVE_NETWORK=bitcoin
# How long proposals are discussed, in minutes; the service's default when unset.
#HIVE_DISCUSSION_MINUTES=10
# Serves each hive's mesh invite at /c/<channel ID>/hive/v1/invite, to anyone who asks. Whoever
# holds an invite can join that hive's mesh, though not spend: off unless uncommented.
#HIVE_SERVE_INVITE=1

# The delegatee. The Emulator's address stays here and out of the repository.
DELEGATEE_NETWORK=bitcoin
DELEGATEE_DATABASE_URL="postgres://hive-delegatee@/delegatee?host=/var/run/postgresql&sslmode=disable"
DELEGATEE_EMULATOR_URL=
DELEGATEE_ADMIN_AUTH=file
DELEGATEE_ADMIN_USERS_FILE=/etc/hive/delegatee-admins

# The hive's tools reach the delegatee through the TLS proxy. setup.sh fills in its key from
# /v1/info once it runs.
BUZZ_DELEGATEE_URL=https://hive.example.org/delegatee
BUZZ_DELEGATE_KEY=

# The Bitcoin price for members who read amounts in dollars, display only: mempool.space by default,
# another source answering { "USD": <price> }, or off.
#HIVE_PRICE_URL=off

# Mainnet is off until you uncomment this line and restart the service.
#BUZZ_MAINNET=enabled

# Each hive's agent node: MeshLLM with the pay-arkade plugin as buyer. Leave HIVE_AGENTS empty to
# run without them, when every hive brings its own node.
HIVE_AGENTS="--agents --mesh /opt/mesh-llm/mesh-llm --pay-arkade /opt/pay-arkade/pay-arkade --worker /opt/pay-arkade/worker/pay-arkade-worker --agent-model qwen3-8b --cap-sats 20000 --period-secs 172800 --agent-arg --network --agent-arg bitcoin --agent-arg --delegate --agent-arg https://delegate.arkade.money"

# Backups: the age public key archives are encrypted to. Its secret half stays off this host.
HIVE_BACKUP_RECIPIENT=

# Where the host's check posts what it finds wrong, as plain text: an ntfy topic, or any address
# that takes a POST. Unset, troubles go to the journal only (journalctl -p err -u hive-check).
#HIVE_ALERT_URL=https://ntfy.sh/<a topic only you know>
