[Unit]
Description=Hive shared service: channels, signing desks and agent nodes
After=network-online.target hive-delegatee.service
Wants=network-online.target hive-delegatee.service

[Service]
User=hive
Group=hive
WorkingDirectory=/opt/hive
EnvironmentFile=/etc/hive/hive.env
# $$ leaves each variable to the shell, which splits HIVE_AGENTS into its flags.
ExecStart=/bin/sh -c 'exec node --experimental-eventsource --import tsx tools/ops.ts service --network "$$HIVE_NETWORK" \
  --public "https://$$HIVE_HOST" --console "https://$$KEEPER_HOST/" --origin "https://$$KEEPER_HOST" \
  --host 127.0.0.1 --port 8080 $${HIVE_DISCUSSION_MINUTES:+--discussion-minutes $$HIVE_DISCUSSION_MINUTES} \
  $${HIVE_SERVE_INVITE:+--serve-invite} $$HIVE_AGENTS'
Restart=always
RestartSec=5
# The code is root's and read-only here; the service writes its own state and nothing else. Each
# hive's agent node is its child and lives under the same limits.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/hive/.local /opt/hive/.secrets
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
